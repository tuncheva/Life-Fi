{
  "name": "life-fi",
  "private": true,
  "version": "0.1.0",
  "description": "Life-Fi: camera-free presence, breathing and fall alerts from Wi-Fi CSI",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "dev": "concurrently -n engine,app -c magenta,green \"npm:dev:engine\" \"npm:dev:app\"",
    "dev:engine": "node scripts/engine.mjs",
    "dev:app": "npm run dev -w ui",
    "build": "npm run build -w ui",
    "start": "concurrently -n engine,app -c magenta,green \"npm:dev:engine\" \"npm run start -w ui\"",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test": "npm run test -w ui",
    "lint": "npm run lint -w ui"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
