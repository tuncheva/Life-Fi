# CSI is compiled out of the Wi-Fi driver unless this is set
CONFIG_ESP_WIFI_CSI_ENABLED=y

# One CSI callback per frame: aggregated frames give fewer, burstier samples
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# 1 ms ticks so the 10 ms ping interval (100 Hz CSI) is exact
CONFIG_FREERTOS_HZ=1000

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Raw CSI over USB (`usbstream`) needs ~35 KB/s; 115200 baud is ~11.5 KB/s.
# The baud rate is only configurable with a "custom" console UART (same UART0
# and default pins).
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
