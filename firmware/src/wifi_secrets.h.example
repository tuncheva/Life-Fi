/* Copy to wifi_secrets.h (git-ignored) and fill in the router the ESP32
 * should connect to. Station mode pings the router at 100 Hz, which gives the
 * best CSI. Without this file the firmware runs in sniffer mode. */
#pragma once

#define LIFEFI_WIFI_SSID     "your-2.4GHz-network"
#define LIFEFI_WIFI_PASSWORD "your-password"

