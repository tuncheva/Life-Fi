{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Life-Fi server: engine client, REST + WebSocket, alerts, history, ntfy",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/main.ts",
    "start": "node --no-warnings=ExperimentalWarning dist/main.js",
    "mock-engine": "tsx src/mock-engine/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.3.2",
    "pino-pretty": "^13.2.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
