# Life-Fi dashboard server env. Copy to ui/.env (git-ignored) and fill in.
# Next.js loads ui/.env for `npm run dev` / `npm start`.

# ---- Firebase / Firestore (event store: history, alerts, state changes, agent runs) ----
# Service account from Firebase console > Project settings > Service accounts > Generate new private key.
# Leave FIREBASE_PROJECT_ID empty to run with an in-memory store (nothing persisted).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The PEM on one line with literal \n, in double quotes.
FIREBASE_PRIVATE_KEY=
# Alternative to the two above: path to the service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=
# Collection name prefix (lifefi_history, lifefi_alerts, lifefi_alert_log, lifefi_events).
FIRESTORE_COLLECTION_PREFIX=lifefi_
# Local emulator instead of the real project (`firebase emulators:start --only firestore`).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---- Caregiver agent ----
# anthropic (default) or gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
